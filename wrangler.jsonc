{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glasstask",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  // Workers AI has no local simulator; see vite.config.ts for how the dev
  // server runs without a Cloudflare account.
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glasstask-db",
      // Replace with the id printed by `wrangler d1 create glasstask-db`.
      // Local dev (miniflare) ignores this value.
      "database_id": "88d0f0c1-35ed-40c5-81d4-6fc55ef98b74",
      "migrations_dir": "migrations"
    }
  ],
  // No vars by default, on purpose.
  //
  // APP_ORIGIN defaults to the origin the request arrived on, which is right
  // both locally and on workers.dev; set it only behind a proxy or custom
  // domain the Worker cannot see.
  //
  // The local-only sign-in is keyed on the request host, not on a var, so it
  // cannot be deployed by forgetting to flip a flag. Set DEV_AUTH to "0" to
  // turn it off locally as well.
  "vars": {}
}
