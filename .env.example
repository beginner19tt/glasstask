# Credentials for the wrangler CLI. Copy to .env (gitignored).
#
# Only needed when `wrangler login` cannot complete, for example when the
# browser cannot reach its callback on http://localhost:8976.
#
# Create at https://dash.cloudflare.com/profile/api-tokens with the
# "Edit Cloudflare Workers" template, plus D1 edit and Workers AI edit.
#
# Delete this file once the deploy is done if you would rather not keep a
# token on disk.

CLOUDFLARE_API_TOKEN=
