# Copy to .dev.vars for local development. All three are optional locally:
# without them, DEV_AUTH=1 provides a local sign-in and the AI routes fall back
# to the deterministic parser. In production set them with `wrangler secret put`.

# openssl rand -hex 32
SESSION_SECRET=

# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-origin>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
